<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Model downloads run in a foreground service so several GB survive the screen going off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The phone updates itself from GitHub Releases; there is no computer in this story. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        The llama.cpp wrapper AAR declares minSdk 30, because its logging header uses an
        API 30 symbol. The recorder itself works fine on Android 8, so rather than drag the
        whole app's floor up, the library's requirement is overridden here and the local
        LLM is gated at runtime instead (LocalModelRuntime.MIN_SDK). On Android 8-10 the
        app records and transcribes; the local AI reports itself unavailable.
    -->
    <uses-sdk tools:overrideLibrary="com.arm.aichat" />

    <!--
        Other builds of this app that can be installed alongside this one. Visible so the app
        can tell the user when another version is holding the microphone.
    -->
    <queries>
        <package android:name="com.recorder.app" />
        <package android:name="com.recorder.app.standard" />
        <package android:name="com.recorder.app.debug" />
        <package android:name="com.recorder.app.v21" />
        <package android:name="com.recorder.app.v21.standard" />
        <package android:name="com.recorder.app.v21.debug" />
    </queries>

    <!-- No SIM ever goes in this phone; nothing here should imply telephony. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".RecorderApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Recorder"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The cover screen. Deliberately NOT a launcher activity: a second MAIN/LAUNCHER
            entry puts a second icon on the home screen and in the app list, which looked
            like two apps. CoverPresenter starts this explicitly on the cover display, which
            needs only android:exported, and Motorola's "allow on external display / auto
            transition" setting applies to the app rather than to a particular activity.

            Small-screen friendly so it lays out sanely on the 4.0in outer panel.
        -->
        <activity
            android:name=".ui.CoverActivity"
            android:exported="true"
            android:label="@string/cover_label"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:turnScreenOn="false" />

        <service
            android:name=".service.RecordingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            Downloads the models. A foreground service rather than work owned by the wizard:
            3.5 GB over phone Wi-Fi outlives the screen staying on, and a download that dies
            when the user looks away is the bug this replaced.
        -->
        <service
            android:name=".models.ModelDownloadService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <!--
                LOCKED_BOOT_COMPLETED is deliberately absent. The app is not direct-boot
                aware and its database lives in credential-encrypted storage, so there is
                nothing useful it could do before the first unlock.
            -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Present so the app can be made device owner, which is the only way a microphone
            foreground service may start after a reboot without a human tapping something.
            Opt-in, and removable from Settings without a factory reset.
        -->
        <receiver
            android:name=".admin.RecorderDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!--
            Required since Android 12 (S) for QR-code device-owner provisioning to complete at
            all: without these two, the system fails provisioning with a generic error before
            RecorderDeviceAdminReceiver ever runs. See DevicePolicyManager's own documentation
            for ACTION_PROVISION_MANAGED_DEVICE, and GetProvisioningModeActivity's doc comment.
            Exported so the system's provisioning flow can launch them; BIND_DEVICE_ADMIN
            restricts that to the platform itself, the same guard the receiver above uses.
        -->
        <activity
            android:name=".admin.GetProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".admin.PolicyComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Hands a downloaded update APK to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
